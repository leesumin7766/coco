          "datasource": {
            "type": "mysql",
            "uid": "mariadb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\\n  UNIX_TIMESTAMP(bucket_start) AS time,\\n  dimension_key AS metric,\\n  metric_value AS value\\nFROM yeezydb.metrics_hourly\\nWHERE metric_name = 'table_total_bytes'\\n  AND bucket_start BETWEEN FROM_UNIXTIME($__unixEpochFrom()) AND FROM_UNIXTIME($__unixEpochTo())\\nORDER BY bucket_start;",
          "refId": "A"
        }
      ],
      "title": "Table Size Growth (metrics_hourly)",
      "type": "timeseries"
