      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "id": 13,
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "mariadb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\\n  REPLACE(SUBSTRING(sql_text, 1, 120), '\\\\n', ' ') AS sql_text,\\n  COUNT(*) AS slow_count,\\n  ROUND(AVG(TIME_TO_SEC(query_time)), 4) AS avg_query_sec\\nFROM mysql.slow_log\\nWHERE start_time BETWEEN FROM_UNIXTIME($__unixEpochFrom()) AND FROM_UNIXTIME($__unixEpochTo())\\nGROUP BY sql_text\\nORDER BY slow_count DESC\\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top 10 Slow Queries (TABLE)",
      "type": "table"
    },
