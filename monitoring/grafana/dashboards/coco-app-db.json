        "uid": "mariadb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 18,
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "mariadb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\\n  UNIX_TIMESTAMP(bucket_time) AS time,\\n  MAX(p95_query_sec) AS value\\nFROM (\\n  SELECT\\n    DATE_FORMAT(start_time, '%Y-%m-%d %H:%i:00') AS bucket_time,\\n    PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY TIME_TO_SEC(query_time))\\n      OVER (PARTITION BY DATE_FORMAT(start_time, '%Y-%m-%d %H:%i:00')) AS p95_query_sec\\n  FROM mysql.slow_log\\n  WHERE start_time BETWEEN FROM_UNIXTIME($__unixEpochFrom()) AND FROM_UNIXTIME($__unixEpochTo())\\n) t\\nGROUP BY bucket_time\\nORDER BY bucket_time;",
          "refId": "A"
        }
      ],
      "title": "Slow Query p95 (TABLE)",
      "type": "timeseries"
    }
